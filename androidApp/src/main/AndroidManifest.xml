<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_day"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:roundIcon="@mipmap/ic_launcher_day"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foliore"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true" />
        <activity
            android:name=".LauncherActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Keep the target enabled for EPUB sharing; switch only these launcher aliases. -->
        <activity-alias
            android:name=".launcher.DawnIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dawn"
            android:roundIcon="@mipmap/ic_launcher_dawn"
            android:label="@string/app_name"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.DayIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_day"
            android:roundIcon="@mipmap/ic_launcher_day"
            android:label="@string/app_name"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.DuskIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dusk"
            android:roundIcon="@mipmap/ic_launcher_dusk"
            android:label="@string/app_name"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.NightIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:roundIcon="@mipmap/ic_launcher_night"
            android:label="@string/app_name"
            android:targetActivity=".LauncherActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".share.EpubShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_label_import_epub"
            android:targetActivity=".MainActivity">
            <intent-filter android:label="@string/share_label_import_epub">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/x-azw3" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/share_label_import_epub">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/x-azw3" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/share_label_import_epub">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/x-epub+zip" />
                <data android:mimeType="application/x-mobipocket-ebook" />
                <data android:mimeType="application/vnd.amazon.ebook" />
                <data android:mimeType="application/x-mobi8-ebook" />
                <data android:mimeType="application/x-azw3" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".share.CoverShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_label_use_as_cover">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
